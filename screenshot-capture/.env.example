# Copy to .env.local — never commit .env.local (already gitignored).
# The Playwright capture script reads these values before launching.

# Base URL of the Drupal site to screenshot.
DOCS_SITE_URL=https://dconnector933.ddev.site

# Drupal admin username / password. Use a dedicated fixture account named
# "Admin (support docs)" so its display name is safe to appear in screenshots.
DRUPAL_USER=admin-docs
DRUPAL_PASS=change-me-locally

# Machine name of the TMGMT translator to screenshot.
TMGMT_TRANSLATOR_ID=lionbridge_content_api
